# ==============================================================================
# TechMasters Digital Celebrations — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE ENVIRONMENT VALUES.
# NEVER COMMIT ACTUAL SECRETS, CREDENTIALS, OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# Django & Core Platform Security
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-min-50-chars
ALLOWED_HOSTS=127.0.0.1,localhost,api.techmasters.internal,neutral-celebrations.vercel.app

# Database Configuration (PostgreSQL 16+)
# In development, leave blank to use local SQLite, or provide managed PostgreSQL URL:
# DATABASE_URL=postgres://user:password@localhost:5432/celebrio_db
DATABASE_URL=

# Cache & Message Broker (Redis 7.x)
REDIS_URL=redis://localhost:6379/0

# Object Storage (Cloudflare R2 / S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=celebrio-prod-deliverables
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Payment Gateway Configuration (Provider Agnostic / Razorpay Reference)
PAYMENT_GATEWAY_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# SMS & WhatsApp Gateway Configuration (MSG91 / Twilio / Meta Cloud API)
SMS_GATEWAY_PROVIDER=MSG91
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
WHATSAPP_API_TOKEN=your_whatsapp_business_api_token

# Platform & Public Neutral Domain Endpoints
PUBLIC_INVITATION_BASE_URL=https://celebrations.domain.neutral
FRONTEND_APP_URL=http://localhost:5173

# Initial Seeding Credentials (Configurable for seed_catalog command)
SEED_ADMIN_EMAIL=admin@techmasters.internal
SEED_ADMIN_PASSWORD=change_this_admin_password_on_initial_setup
SEED_DEV_PASSWORD=change_this_dev_password_on_initial_setup
